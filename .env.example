# Required for retrieval; offline commands need no keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional primary source; auto selects WoS when configured.
WOS_API_KEY=
WOS_MAX_REQUESTS=60
WOS_MIN_INTERVAL=1.1

# OpenAlex account credentials, if required by your access tier.
OPENALEX_EMAIL=
OPENALEX_API_KEY=
BOOKWORM_OPENALEX_MAX_REQUESTS=200
BOOKWORM_REQUEST_TIMEOUT=60

# Relative to --home / BOOKWORM_HOME / current directory.
BOOKWORM_CACHE_DIR=artifacts/cache
BOOKWORM_RUNS_DIR=artifacts/runs
BOOKWORM_KEEP_CACHE=true
# Leave blank for per-run output; an existing vault uses Bookworm/<run>/.
BOOKWORM_OBSIDIAN_VAULT=

# Legacy SCIB_* and SCIBOOSTER_HOME names are still accepted.
# Earlier run directories are always retained, regardless of SCIB_KEEP_HISTORY.
